            "type": "number",
            "name": "moisture",
            "title": {
              "en": "Moisture",
              "fr": "Humidité"
            },
            "min": 0,
            "max": 100,
            "step": 1
          },
          {
            "type": "text",
            "name": "zones",
            "required": false,
            "title": {
