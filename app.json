        "id": "start_watering",
        "title": {
          "en": "Start watering",
          "fr": "Démarrer l'arrosage"
        },
        "titleFormatted": {
          "en": "Water for [[duration]] min on [[zones]] with [[delay]] min delay",
          "fr": "Arroser [[duration]] min sur [[zones]] avec [[delay]] min de délai"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=controller"
          },
          {
            "type": "number",
            "name": "duration",
            "title": {
              "en": "Duration",
              "fr": "Durée"
            },
            "min": 1,
            "max": 120,
            "step": 1,
            "placeholder": {
              "en": "minutes",
              "fr": "minutes"
            }
          },
          {
            "type": "text",
            "name": "zones",
            "required": false,
            "title": {
              "en": "Zones",
              "fr": "Zones"
            },
            "placeholder": {
              "en": "e.g. 1,2 — all if empty",
              "fr": "ex : 1,2 — toutes si vide"
            }
          },
          {
            "type": "number",
            "name": "delay",
            "required": false,
            "title": {
              "en": "Delay",
              "fr": "Délai"
            },
            "min": 0,
            "max": 1440
          }
        ]
      },
      {
        "id": "stop_watering",
        "title": {
          "en": "Stop watering",
          "fr": "Arrêter l'arrosage"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=controller"
          }
        ]
      },
      {
        "id": "no_water",
        "title": {
          "en": "Skip watering for N days",
          "fr": "Ne pas arroser pendant N jours"
        },
        "titleFormatted": {
          "en": "Skip watering for [[days]] days",
          "fr": "Ne pas arroser pendant [[days]] jours"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=controller"
          },
          {
            "type": "number",
            "name": "days",
            "title": {
              "en": "Days",
              "fr": "Jours"
            },
            "min": 1,
            "max": 100
          }
        ]
      },
      {
        "id": "set_moisture",
        "title": {
          "en": "Set zone moisture",
          "fr": "Forcer l'humidité d'une zone"
        },
        "titleFormatted": {
          "en": "Set moisture to [[moisture]]% on [[zones]]",
          "fr": "Forcer l'humidité à [[moisture]]% sur [[zones]]"
        },
        "hint": {
          "en": "Overrides the smart estimate. Set 100% after rain to make Netro skip a cycle.",
